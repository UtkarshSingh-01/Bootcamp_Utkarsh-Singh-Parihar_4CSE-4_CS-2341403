// Q1. Product of Array Except Self Given an integer array nums, 
// return an array answer such that answer[i] is equal to the product of 
// all elements of nums except nums[i]. You must solve it in O(n) time and without using division.

public int[] product(int[] nums){
    int ans[] = new int[nums.length];
    ans[0] = 1;
    for(int i = 1; i < nums.length; i++){
        ans[i] = ans[i-1]*nums[i-1];
    }
    int right = 1;
    for(int i = nums.length; i >= 0; i--){
        ans[i] *= right;
        right *= nums[i];
    }
    return ans;
}
